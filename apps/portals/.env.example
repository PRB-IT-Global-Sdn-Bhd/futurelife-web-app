# Copy to `.env.local` for local development. Never commit secrets.
# In Vercel: set only NEXT_PUBLIC_* below in the dashboard (Production vs Preview scopes).

# —— Runtime (NEXT_PUBLIC_* — safe in browser) ——
# Local:
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Preview (Dashboard → Environment Variables → Preview):
#   NEXT_PUBLIC_APP_ENV=preview
#   NEXT_PUBLIC_APP_URL=https://${VERCEL_URL}   # or leave unset; app can read VERCEL_URL server-side later
# Vercel automatically injects VERCEL_URL on each preview deployment (no need to copy the hostname).

# Vercel Production (Dashboard → Production, branch main):
#   NEXT_PUBLIC_APP_ENV=production
#   NEXT_PUBLIC_APP_URL=https://<your-production-hostname>

# —— Node.js API (Staging / Production — Mahir provides; not wired in Phase 0) ——
# Preview + Staging:
# NEXT_PUBLIC_API_BASE_URL=https://api-staging.example.futurelife.my
# Production:
# NEXT_PUBLIC_API_BASE_URL=https://api.example.futurelife.my

# —— Stripe (MYR). Test keys on Preview/Development; live keys only on Production. ——
# Preview / local:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Production only:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# —— Server-only (set in Vercel if/when used; never NEXT_PUBLIC_) ——
# STRIPE_SECRET_KEY=sk_test_...  # Preview
# STRIPE_SECRET_KEY=sk_live_...  # Production
# STRIPE_WEBHOOK_SECRET=whsec_...
# API_INTERNAL_BASE_URL=
# SESSION_COOKIE_NAME=fl_session
# SENTRY_DSN=
# LOG_LEVEL=info