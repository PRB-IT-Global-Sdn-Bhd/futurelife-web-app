# Copy to `.env.local` for local development. Never commit secrets.

# —— Runtime ——
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Public site URL (Vercel sets VERCEL_URL automatically on preview deploys)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# —— Node.js API (Staging / Production — provided by Mahir; not wired in Phase 0) ——
# NEXT_PUBLIC_API_BASE_URL=https://api-staging.example.futurelife.my
# API_INTERNAL_BASE_URL=  # server-only, if used later

# —— Auth (sessions via Node.js — Phase 0 does not call these) ——
# SESSION_COOKIE_NAME=fl_session
# AUTH_ISSUER=

# —— Stripe (MYR). Use test keys in Dev/Staging; live keys only in Production. ——
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Production placeholders (do not use test keys):
# STRIPE_SECRET_KEY_LIVE=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...

# —— Observability (optional; vendor wiring in later phases) ——
# SENTRY_DSN=
# LOG_LEVEL=info