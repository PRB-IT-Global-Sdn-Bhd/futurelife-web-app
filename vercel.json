{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd apps/portals && npm ci",
  "buildCommand": "cd apps/portals && npm run build",
  "devCommand": "cd apps/portals && npm run dev",
  "github": {
    "silent": true
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/portals/"
}